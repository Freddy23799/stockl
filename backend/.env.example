# -----------------------------------------------------------------------------
# Les SEULES variables a definir en production.
#
# Tout le reste (port du backend, hote / port / utilisateur / nom de la base)
# est fige dans src/config/index.js avec les valeurs de production. Rien d'autre
# a renseigner sur la machine du client.
# -----------------------------------------------------------------------------

# Mot de passe du role PostgreSQL "machibel"
DB_PASSWORD=

# Secret de signature des tokens de session.
# Generez-le avec : npm run generate-secret
JWT_SECRET=


# -----------------------------------------------------------------------------
# DEV UNIQUEMENT - a decommenter sur la machine de developpement.
#
# En dev, PostgreSQL tourne dans le conteneur Docker (voir docker-compose.yml a
# la racine) sur le port 5439, alors que le defaut du code est 5432, le port du
# PostgreSQL natif Windows de la production.
# -----------------------------------------------------------------------------
# NODE_ENV=development
# DB_PORT=5439
